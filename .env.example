# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring

# @BotFather bergan token
BOT_TOKEN=

# Adminlarning Telegram ID raqamlari, vergul bilan (@userinfobot orqali bilib olinadi)
ADMIN_IDS=

# Google jadval havolasidagi ID: docs.google.com/spreadsheets/d/<SHU_QISMI>/edit
GOOGLE_SHEET_ID=
# Nisbiy yo'l loyiha papkasidan olinadi; mutlaq yo'l ham ishlaydi.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_WORKSHEET=Arizalar

# Kampaniya sanalari (YYYY-MM-DD)
REGISTRATION_DEADLINE=2026-11-28
TEST_DATE=2026-11-29

# Sinflar bo'yicha test vaqti
TEST_TIME_1_4=09:00
TEST_TIME_5_7=11:30
TEST_TIME_8_10=14:00

# Maktab lokatsiyasi (ixtiyoriy). Google Maps'da nuqtani bosib, koordinatani oling
SCHOOL_LAT=40.437654966548244
SCHOOL_LON=70.60520553763767

TIMEZONE=Asia/Tashkent
DB_PATH=bot.db
